// ============================================================================
//  AUCTION CONTEXT ENGINE (ACE)
//  AMT · Volume Profile · VWAP · Market Structure
// ----------------------------------------------------------------------------
//  All code in this script is original. No third-party Pine Script source has
//  been copied or adapted. See docs/02-licensing.md for the licensing audit.
// ----------------------------------------------------------------------------
//  WHAT THIS IS:      a market-context / decision-support tool.
//  WHAT THIS IS NOT:  a signal generator, a predictor, or a probability model.
//                     It produces no BUY/SELL output and makes no accuracy claim.
// ----------------------------------------------------------------------------
//  ARCHITECTURE (docs/03-architecture.md)
//
//    DATA LAYER          ATR, RVOL, session detection, data-quality guards
//    L3 FOOTPRINT        isolated, removable adapter (Premium/Ultimate only)
//    PROFILE ENGINE      bins, POC, VA, HVN/LVN, developing values      [P1]
//    AMT ENGINE          IB, OR, balance, acceptance, initiative        [P4]
//    VWAP ENGINE         session/period/anchored + deviation bands      [P3]
//    STRUCTURE ENGINE    swings, HH/HL/LH/LL, BOS, CHoCH, MSS           [P5]
//    LIQUIDITY ENGINE    EQH/EQL, pools, sweeps                         [P6]
//    IMBALANCE ENGINE    FVG, displacement, order blocks                [P6]
//    ---------------------------------------------------------------------
//    CONTEXT ENGINE      facts -> normalised component scores           [P8]
//    SCORING ENGINE      weights, decay, bias, confidence               [P8]
//    DASHBOARD           full explainability of every contribution      [P9]
//
//  INVARIANT #1 (FACT / INTERPRETATION)
//    Engines above the line emit measurable values and states ONLY. They never
//    decide "bullish" or "bearish". All interpretation lives in the Context and
//    Scoring engines. This separation is enforced by file structure, not by
//    discipline alone.
//
//  INVARIANT #2 (NO DATA != NEUTRAL)
//    Every component carries a `valid` flag. An invalid component is removed
//    from the denominator of the weighted average - it never drags the bias
//    toward zero.
//
//  INVARIANT #3 (HONEST REPAINTING)
//    No barmerge.lookahead_on. No future leak. Confirm-on-bar-close defaults ON.
//    Pivot lag, zone backpainting and footprint source-drift are documented in
//    the UI itself, not buried in the description. See docs/06-repainting.md.
// ============================================================================

//@version=6

// The declaration statement must be the first statement in the script, so the
// title is written literally here and mirrored by the constants below.
indicator(
     title               = "Auction Context Engine (ACE)",
     shorttitle          = "ACE",
     overlay             = true,
     max_boxes_count     = 500,
     max_lines_count     = 500,
     max_labels_count    = 500,
     max_polylines_count = 100,
     max_bars_back       = 5000)

// ============================================================================
//  0. VERSION
// ============================================================================
const string ACE_NAME    = "Auction Context Engine"
const string ACE_SHORT   = "ACE"
const string ACE_VERSION = "0.3.0-P3"
const string ACE_PHASE   = "P3 - vwap engine"
const string ACE_BUILD   = "STD"   // rewritten to "STD" by tools/build.py

// ============================================================================
//  1. ENUMS
// ============================================================================

//@enum Performance profile. Sets defaults for several subsystems at once.
enum PerfMode
    lite     = "Lite"
    standard = "Standard"
    pro      = "Pro"

//@enum Source of the volume distribution used to build profiles.
enum DataSource
    auto      = "Auto (best available)"
    barClose  = "L0 - Bar (close only)"
    barDist   = "L1 - Bar (distributed)"
    ltf       = "L2 - Lower timeframe"
    footprint = "L3 - Footprint (Premium+)"

//@enum Anchor that defines where one profile period starts and ends.
enum ProfileAnchor
    session = "Session / Day"
    daily   = "Daily"
    weekly  = "Weekly"
    monthly = "Monthly"
    fixed   = "Fixed bar count"

//@enum How a bar's volume is spread across price when using bar-based models.
enum DistModel
    closeOnly = "Close only (M1)"
    uniform   = "Uniform range (M2)"
    weighted  = "OHLC weighted (M3)"

//@enum Value Area construction algorithm.
enum VaAlgo
    classic = "Classic (pairwise from POC)"
    sorted  = "Sorted descending"

//@enum Balance / imbalance detection method.
enum BalanceMode
    atrRange   = "ATR range"
    vaOverlap  = "Value Area overlap"
    efficiency = "Efficiency ratio"
    combined   = "Combined (2 of 3)"

//@enum Break confirmation style for market structure.
enum BreakMode
    closeBreak = "Close through level"
    wickBreak  = "Wick through level"

//@enum Order block rule set. Convention-dependent by nature.
enum ObRule
    lastOpposite  = "Last opposite candle"
    highestVolume = "Highest volume opposite candle"
    bodyThreshold = "Body threshold"

//@enum Directional volume proxy model.
enum DeltaModel
    closeDir = "D1 - Close direction"
    closePos = "D2 - Close position in range"
    ltfAgg   = "D3 - Lower timeframe aggregation"
    fpNative = "D4 - Footprint (Premium+)"

//@enum Price series a VWAP is weighted on. hlc3 matches the built-in ta.vwap.
enum VwapSource
    hlc3  = "hlc3 (matches ta.vwap)"
    close = "close"
    hl2   = "hl2"
    ohlc4 = "ohlc4"

//@enum Anchor for an Anchored VWAP.
enum AnchorMode
    dateTime      = "Date / time"
    sessionOpen   = "Session open"
    weekOpen      = "Week open"
    monthOpen     = "Month open"
    yearOpen      = "Year open"
    highestHigh   = "Highest high in lookback"
    lowestLow     = "Lowest low in lookback"
    lastSwingHigh = "Last swing high (needs P5)"
    lastSwingLow  = "Last swing low (needs P5)"
    lastBos       = "Last BOS (needs P5)"

//@enum How the VWAP bands are sized.
enum BandMode
    stdev   = "Standard deviation"
    percent = "Percentage"

//@enum Which VWAP the bands, z-score and score component refer to.
enum PrimaryVwap
    session = "Session"
    daily   = "Daily"
    weekly  = "Weekly"
    monthly = "Monthly"
    anchor1 = "Anchored #1"
    anchor2 = "Anchored #2"

//@enum Colour theme.
enum Theme
    autoTheme = "Auto (follow chart)"
    dark      = "Dark"
    light     = "Light"

//@enum Dashboard anchor position.
enum DashPos
    topLeft      = "Top left"
    topCenter    = "Top center"
    topRight     = "Top right"
    middleLeft   = "Middle left"
    middleRight  = "Middle right"
    bottomLeft   = "Bottom left"
    bottomCenter = "Bottom center"
    bottomRight  = "Bottom right"

//@enum Dashboard text size.
enum DashSize
    tiny   = "Tiny"
    small  = "Small"
    normal = "Normal"
    large  = "Large"

// ============================================================================
//  2. USER-DEFINED TYPES
// ============================================================================

//@type A price-binned volume distribution over an arbitrary bar range.
type Profile
    float        lo        = na       // lower grid boundary
    float        hi        = na       // upper grid boundary
    int          bins      = 0
    float        step      = na
    array<float> vol       = na       // total volume per bin
    array<float> volUp     = na       // directional volume, up
    array<float> volDn     = na       // directional volume, down
    array<float> tpo       = na       // time-at-price counter (works without volume)
    float        poc       = na
    float        vah       = na
    float        val       = na
    float        total     = 0.0
    float        tpoTotal  = 0.0
    bool         clamped   = false   // grid hit its cap: tails may be mis-binned
    int          startBar  = na
    int          endBar    = na
    string       model     = "none"   // data level actually used: BAR / LTF / FOOTPRINT
    bool         ready     = false

//@type A confirmed swing point.
type Swing
    float  price  = na
    int    bar    = na
    bool   isHigh = false
    string tag    = ""                // HH | HL | LH | LL

//@type A price zone: FVG, order block or liquidity pool.
type Zone
    float top       = na
    float bot       = na
    int   startBar  = na
    bool  bull      = false
    int   kind      = 0               // 0 = FVG, 1 = OB, 2 = liquidity
    float mitigated = 0.0             // 0.0 .. 1.0
    bool  active    = true
    box   bx        = na
    line  ln        = na

//@type One input to the scoring engine. See INVARIANT #1 and #2.
type Component
    string name      = ""
    string state     = "-"            // human-readable state, shown in dashboard
    float  raw       = 0.0            // -1 .. +1, meaningful only when `valid`
    float  weight    = 1.0
    bool   enabled   = true           // user switch
    bool   valid     = false          // has usable data  -> NO DATA != NEUTRAL
    bool   approx    = false          // derived from a drifting source (marked ~)
    int    barsSince = 0              // event age, for decay
    string reason    = ""             // why this score, in words

//@type Aggregate output of the scoring engine.
type ScoreResult
    float  bias         = 0.0
    float  bull         = 0.0
    float  bear         = 0.0
    float  coverage     = 0.0
    float  agreement    = 0.0
    float  strength     = 0.0
    float  confidence   = 0.0
    int    activeCount  = 0
    int    enabledCount = 0
    string label        = "NO DATA"

//@type Per-engine readiness and headline values, consumed by the dashboard.
type EngineState
    string name    = ""
    bool   ready   = false
    string phase   = ""
    string summary = "not implemented"

// ============================================================================
//  3. INPUTS
// ============================================================================

const string G_GEN  = "1 · General"
const string G_AMT  = "2 · Auction / AMT"
const string G_VP   = "3 · Volume Profile"
const string G_VWAP = "4 · VWAP"
const string G_MS   = "5 · Market Structure"
const string G_LIQ  = "6 · Liquidity"
const string G_IMB  = "7 · Imbalance"
const string G_OF   = "8 · Order Flow / Volume"
const string G_CTX  = "9 · Context Engine"
const string G_DASH = "10 · Dashboard"
const string G_DBG  = "11 · Debug"

// ---- GENERAL ---------------------------------------------------------------
PerfMode perfMode = input.enum(PerfMode.standard, "Performance mode", group = G_GEN,
     tooltip = "Sets defaults for bins, profile count, rendering and data source. " +
               "Individual switches below always override the mode.")
Theme themeIn = input.enum(Theme.autoTheme, "Theme", group = G_GEN)
bool confirmClose = input.bool(true, "Confirm signals on bar close", group = G_GEN,
     tooltip = "ON (recommended): every fact and the whole score are gated by " +
               "barstate.isconfirmed, so nothing flickers intrabar. " +
               "OFF: values update live inside the forming bar.")
bool showFacts = input.bool(true, "Show FACT layer", group = G_GEN,
     tooltip = "Objectively detectable events: swings, BOS, FVG, sweeps, POC/VA, VWAP.")
bool showInterp = input.bool(true, "Show INTERPRETATION layer", group = G_GEN,
     tooltip = "Convention-dependent constructs: balance, acceptance, order blocks, " +
               "accumulation candidates. These depend on the rules you select.")
int maxDrawBars = input.int(500, "Max bars to draw on", minval = 50, maxval = 5000, group = G_GEN,
     tooltip = "Drawings are limited to the most recent N bars to stay inside " +
               "the 500-object limits and keep the script fast.")

// ---- AUCTION / AMT ---------------------------------------------------------
float vaPercent = input.float(70.0, "Value Area %", minval = 1.0, maxval = 100.0, step = 1.0, group = G_AMT)
VaAlgo vaAlgo = input.enum(VaAlgo.classic, "Value Area algorithm", group = G_AMT,
     tooltip = "Classic: expands from the POC two bins at a time (CBOT convention). " +
               "Sorted: takes the highest-volume bins until the target is met - simpler, " +
               "but may select non-contiguous bins and will not match a standard profile.")
int ibMinutes = input.int(60, "Initial Balance (minutes)", minval = 1, group = G_AMT)
bool showIbExt = input.bool(true, "Show IB extensions (1x / 2x)", group = G_AMT)
int orMinutes = input.int(15, "Opening Range (minutes)", minval = 1, group = G_AMT)
BalanceMode balMode = input.enum(BalanceMode.combined, "Balance detection", group = G_AMT,
     tooltip = "There is no canonical definition of balance. Combined requires " +
               "2 of 3 methods to agree. See docs/04-algorithms.md section 3.3.")
int balLookback = input.int(20, "Balance lookback (bars)", minval = 5, group = G_AMT)
float balAtrMult = input.float(1.5, "Balance range (x ATR)", minval = 0.1, step = 0.1, group = G_AMT)
int accCloses = input.int(2, "Acceptance: closes required", minval = 1, group = G_AMT,
     tooltip = "Acceptance thresholds are conventional, not canonical.")
float accTimePct = input.float(50.0, "Acceptance: time beyond level %", minval = 1.0, maxval = 100.0, group = G_AMT)
float rejWick = input.float(0.6, "Rejection: wick ratio", minval = 0.1, maxval = 1.0, step = 0.05, group = G_AMT)

// ---- VOLUME PROFILE --------------------------------------------------------
DataSource dataSrcIn = input.enum(DataSource.auto, "Profile data source", group = G_VP,
     tooltip = "Auto tries Footprint -> LTF -> Bar and reports what it actually used. " +
               "L3 Footprint requires a TradingView Premium or Ultimate plan and is " +
               "subject to source drift (see docs/08-footprint.md).")
DistModel distModel = input.enum(DistModel.weighted, "Bar distribution model", group = G_VP,
     tooltip = "Used for L0/L1, and as the fallback whenever LTF or footprint data " +
               "is unavailable for a bar.")
ProfileAnchor profAnchor = input.enum(ProfileAnchor.session, "Profile period", group = G_VP)
int binsIn = input.int(50, "Bins", minval = 10, maxval = 500, group = G_VP,
     tooltip = "Target bin count at period open. The bin WIDTH is fixed for the " +
               "whole period; if price leaves the grid, the grid is extended with " +
               "empty bins instead of being rebuilt, so nothing is ever redistributed.")
float profRangeAtr = input.float(10.0, "Expected period range (x ATR)", minval = 1.0, step = 0.5, group = G_VP,
     tooltip = "Sets the initial bin width: step = ATR * this / bins. Too small and " +
               "the grid extends often; too large and the profile looks coarse.")
int maxBinsPerBar = input.int(60, "Max bins one bar may span", minval = 5, maxval = 300, group = G_VP,
     tooltip = "Safety valve. A single bar covering more bins than this falls back " +
               "to close-only distribution and the profile is flagged CLAMPED.")
int profileLookback = input.int(200, "Fixed lookback (bars)", minval = 20, group = G_VP)
int profilesToShow = input.int(2, "Profiles to show", minval = 1, maxval = 5, group = G_VP)
bool showPoc = input.bool(true, "Show POC", group = G_VP, inline = "lv")
bool showVa = input.bool(true, "Show VAH / VAL", group = G_VP, inline = "lv")
bool showDevPoc = input.bool(true, "Show developing POC / VA", group = G_VP)
int devRecalcEvery = input.int(1, "Developing recalc every N bars", minval = 1, maxval = 50, group = G_VP)
bool showNodes = input.bool(true, "Show HVN / LVN", group = G_VP, inline = "nd")
float hvnThr = input.float(0.70, "HVN", minval = 0.1, maxval = 1.0, step = 0.05, group = G_VP, inline = "nd")
float lvnThr = input.float(0.25, "LVN", minval = 0.01, maxval = 1.0, step = 0.05, group = G_VP, inline = "nd")
int nodeWin = input.int(3, "Node detection window (bins)", minval = 1, maxval = 20, group = G_VP)
bool showHisto = input.bool(true, "Draw profile histogram", group = G_VP)
float histoWidthPct = input.float(30.0, "Histogram width (% of period)", minval = 5.0, maxval = 100.0, group = G_VP)
bool extendLevels = input.bool(true, "Extend POC / VA levels to the right", group = G_VP)
bool showPrevProfile = input.bool(true, "Show previous period profile", group = G_VP)
bool showTpo = input.bool(false, "Show TPO (time-at-price) profile", group = G_VP,
     tooltip = "Counts bars per price level instead of volume. Works on instruments " +
               "with no volume data, and is closer to classic Market Profile.")

// ---- VWAP ------------------------------------------------------------------
VwapSource vwapSrcIn = input.enum(VwapSource.hlc3, "Source", group = G_VWAP,
     tooltip = "hlc3 is what the built-in ta.vwap uses. Change it only if you " +
               "specifically want a different weighting - the Session VWAP will " +
               "then no longer match the platform reference.")
PrimaryVwap primaryVwap = input.enum(PrimaryVwap.session, "Primary VWAP (bands, z-score, score)", group = G_VWAP)
bool useSessionVwap = input.bool(true, "Session", group = G_VWAP, inline = "v1")
bool useDailyVwap = input.bool(false, "Daily", group = G_VWAP, inline = "v1")
bool useWeeklyVwap = input.bool(false, "Weekly", group = G_VWAP, inline = "v1")
bool useMonthlyVwap = input.bool(false, "Monthly", group = G_VWAP, inline = "v1",
     tooltip = "Session resets at the trading-session open (same rule as ta.vwap). " +
               "Daily resets at the calendar day in exchange time. On 24h symbols " +
               "the two coincide; on futures with an evening open they do not.")
bool showVwapBands = input.bool(true, "Deviation bands", group = G_VWAP, inline = "v2")
float vwapDev1 = input.float(1.0, "", minval = 0.1, step = 0.1, group = G_VWAP, inline = "v2")
float vwapDev2 = input.float(2.0, "", minval = 0.1, step = 0.1, group = G_VWAP, inline = "v2")
float vwapDev3 = input.float(3.0, "", minval = 0.1, step = 0.1, group = G_VWAP, inline = "v2")
BandMode bandMode = input.enum(BandMode.stdev, "Band mode", group = G_VWAP,
     tooltip = "Standard deviation is volume weighted around the current mean, " +
               "computed from accumulated moments (sumP2V/sumV - vwap^2). " +
               "Percentage is a fixed fraction of the VWAP price.")
bool showVwapFill = input.bool(true, "Shade the first band", group = G_VWAP)
float zSaturation = input.float(2.0, "Z-score saturation for scoring", minval = 0.5, step = 0.1, group = G_VWAP,
     tooltip = "The VWAP score reaches its maximum at this many sigma. " +
               "Higher = the component saturates more slowly.")

bool useAnchored1 = input.bool(false, "Anchored VWAP #1", group = G_VWAP, inline = "a1")
AnchorMode anc1Mode = input.enum(AnchorMode.dateTime, "", group = G_VWAP, inline = "a1")
int anc1Time = input.time(timestamp("01 Jan 2024 00:00 +0000"), "Anchor #1 date", group = G_VWAP)
int anc1Lookback = input.int(200, "Anchor #1 extreme lookback", minval = 5, maxval = 500, group = G_VWAP)

bool useAnchored2 = input.bool(false, "Anchored VWAP #2", group = G_VWAP, inline = "a2")
AnchorMode anc2Mode = input.enum(AnchorMode.highestHigh, "", group = G_VWAP, inline = "a2")
int anc2Time = input.time(timestamp("01 Jan 2024 00:00 +0000"), "Anchor #2 date", group = G_VWAP)
int anc2Lookback = input.int(200, "Anchor #2 extreme lookback", minval = 5, maxval = 500, group = G_VWAP)

// ---- MARKET STRUCTURE ------------------------------------------------------
int swingLen = input.int(5, "Swing length", minval = 1, maxval = 50, group = G_MS,
     tooltip = "A swing is confirmed only after this many bars. That is a CONFIRMATION " +
               "DELAY, not repainting - but it does mean the historical chart shows " +
               "structure earlier than it could have been known live.")
BreakMode breakMode = input.enum(BreakMode.closeBreak, "Structure confirmation", group = G_MS,
     tooltip = "Close: the bar must close beyond the level (no intrabar flicker). " +
               "Wick: triggers intrabar and can flicker until the bar closes.")
bool showBos = input.bool(true, "BOS", group = G_MS, inline = "ms")
bool showChoch = input.bool(true, "CHoCH", group = G_MS, inline = "ms")
bool showMss = input.bool(true, "MSS", group = G_MS, inline = "ms")
bool showSwingTags = input.bool(true, "Show HH / HL / LH / LL", group = G_MS)
bool showPremiumDiscount = input.bool(true, "Show Premium / Discount / EQ", group = G_MS)
bool showConfirmDelay = input.bool(false, "Mark actual detection bar", group = G_MS,
     tooltip = "Draws a marker on the bar where the event was actually detectable, " +
               "not only where it is drawn. Turn this on to see the real latency.")

// ---- LIQUIDITY -------------------------------------------------------------
bool showEqual = input.bool(true, "Equal Highs / Lows", group = G_LIQ)
float eqTol = input.float(0.10, "Equal tolerance (x ATR)", minval = 0.01, maxval = 1.0, step = 0.01, group = G_LIQ)
int eqMaxGap = input.int(50, "Max bars between equal points", minval = 2, group = G_LIQ)
bool showPools = input.bool(true, "Liquidity pools", group = G_LIQ)
bool showSweeps = input.bool(true, "Sweeps", group = G_LIQ)
bool sweepNeedsChoch = input.bool(false, "Sweep requires following CHoCH", group = G_LIQ,
     tooltip = "Far fewer false positives, at the cost of a delay of up to N bars.")
int sweepConfirmBars = input.int(5, "Sweep confirmation window (bars)", minval = 1, group = G_LIQ)

// ---- IMBALANCE -------------------------------------------------------------
bool showFvg = input.bool(true, "Fair Value Gaps", group = G_IMB)
float minFvgAtr = input.float(0.15, "Min FVG size (x ATR)", minval = 0.0, step = 0.05, group = G_IMB)
bool hideMitigated = input.bool(true, "Hide fully mitigated zones", group = G_IMB)
bool showDisp = input.bool(true, "Displacement", group = G_IMB)
float dispBodyAtr = input.float(1.5, "Displacement body (x ATR)", minval = 0.1, step = 0.1, group = G_IMB)
bool dispNeedsFvg = input.bool(true, "Displacement must create an FVG", group = G_IMB)
bool showOb = input.bool(true, "Order Blocks", group = G_IMB,
     tooltip = "CONVENTION-DEPENDENT. Competing definitions exist; the rule you pick " +
               "below changes the result. Order blocks are also drawn on a past candle " +
               "after the break confirms them (backpainting) - they were not knowable " +
               "at that candle's close.")
ObRule obRule = input.enum(ObRule.lastOpposite, "Order Block rule", group = G_IMB)
int maxZones = input.int(25, "Max active zones", minval = 5, maxval = 200, group = G_IMB)

// ---- ORDER FLOW / VOLUME ---------------------------------------------------
DeltaModel deltaModelIn = input.enum(DeltaModel.closePos, "Directional volume model", group = G_OF,
     tooltip = "D1/D2/D3 are PROXIES derived from price action, not order flow. " +
               "D4 uses TradingView's footprint data, which is also classified by " +
               "intrabar price direction - it is higher quality, but still not " +
               "bid/ask aggressor data. True delta is not available in Pine Script.")
int rvolLen = input.int(20, "Relative volume length", minval = 2, group = G_OF)
float rvolThr = input.float(1.5, "Relative volume confirm threshold", minval = 0.1, step = 0.1, group = G_OF)
int atrLen = input.int(14, "ATR length", minval = 1, group = G_OF)

// ---- CONTEXT ENGINE --------------------------------------------------------
bool enAmt = input.bool(true, "AMT", group = G_CTX, inline = "c1")
float wAmt = input.float(2.0, "w", minval = 0.0, step = 0.1, group = G_CTX, inline = "c1")
bool enVp = input.bool(true, "Volume Profile", group = G_CTX, inline = "c2")
float wVp = input.float(2.0, "w", minval = 0.0, step = 0.1, group = G_CTX, inline = "c2")
bool enStruct = input.bool(true, "Structure", group = G_CTX, inline = "c3")
float wStruct = input.float(2.0, "w", minval = 0.0, step = 0.1, group = G_CTX, inline = "c3")
bool enVwap = input.bool(true, "VWAP", group = G_CTX, inline = "c4")
float wVwap = input.float(1.5, "w", minval = 0.0, step = 0.1, group = G_CTX, inline = "c4")
bool enLiq = input.bool(true, "Liquidity", group = G_CTX, inline = "c5")
float wLiq = input.float(1.0, "w", minval = 0.0, step = 0.1, group = G_CTX, inline = "c5")
bool enImb = input.bool(true, "Imbalance", group = G_CTX, inline = "c6")
float wImb = input.float(1.0, "w", minval = 0.0, step = 0.1, group = G_CTX, inline = "c6")
bool enVol = input.bool(true, "Volume", group = G_CTX, inline = "c7")
float wVol = input.float(0.5, "w", minval = 0.0, step = 0.1, group = G_CTX, inline = "c7")
int decayHalfLife = input.int(20, "Event decay half-life (bars)", minval = 1, group = G_CTX,
     tooltip = "Event components (BOS, sweep, FVG, displacement) lose half of their " +
               "weight every N bars: score * 0.5 ^ (age / halfLife).")
float thrNeutral = input.float(0.15, "Neutral threshold", minval = 0.0, maxval = 1.0, step = 0.01, group = G_CTX)
float thrWeak = input.float(0.35, "Weak threshold", minval = 0.0, maxval = 1.0, step = 0.01, group = G_CTX)
float thrStrong = input.float(0.60, "Strong threshold", minval = 0.0, maxval = 1.0, step = 0.01, group = G_CTX)
float minConfidence = input.float(0.35, "Minimum confidence", minval = 0.0, maxval = 1.0, step = 0.01, group = G_CTX,
     tooltip = "Below this, the context is reported as CONFLICTED regardless of bias. " +
               "Confidence measures internal agreement of the model. It is NOT a " +
               "probability that price will move in any direction.")

// ---- DASHBOARD -------------------------------------------------------------
bool showDash = input.bool(true, "Show dashboard", group = G_DASH)
DashPos dashPosIn = input.enum(DashPos.topRight, "Position", group = G_DASH)
DashSize dashSizeIn = input.enum(DashSize.small, "Size", group = G_DASH)
bool dashBreakdown = input.bool(true, "Component breakdown", group = G_DASH)
bool dashWeights = input.bool(true, "Weights and contributions", group = G_DASH)
bool dashReason = input.bool(true, "Reason column", group = G_DASH)
bool dashChanged = input.bool(true, "'What changed' row", group = G_DASH)

// ---- DEBUG -----------------------------------------------------------------
bool dbgOn = input.bool(false, "Debug mode", group = G_DBG,
     tooltip = "Shows an engine/runtime panel. Development aid - keep it off in normal use.")
bool dbgEngines = input.bool(true, "Engine readiness", group = G_DBG)
bool dbgRuntime = input.bool(true, "Runtime and data quality", group = G_DBG)
bool dbgAssert = input.bool(true, "Enable internal assertions", group = G_DBG,
     tooltip = "Raises a runtime error on an internal inconsistency instead of " +
               "silently producing wrong numbers.")

// ============================================================================
//  4. RESOLVED CONFIGURATION
//     The performance mode only supplies DEFAULTS; explicit inputs win.
// ============================================================================

int resolvedBins = switch perfMode
    PerfMode.lite     => math.min(binsIn, 24)
    PerfMode.standard => math.min(binsIn, 150)
    PerfMode.pro      => binsIn
    => binsIn

int resolvedProfiles = switch perfMode
    PerfMode.lite     => 1
    PerfMode.standard => math.min(profilesToShow, 2)
    PerfMode.pro      => profilesToShow
    => profilesToShow

int resolvedMaxZones = switch perfMode
    PerfMode.lite     => math.min(maxZones, 10)
    PerfMode.standard => math.min(maxZones, 25)
    PerfMode.pro      => maxZones
    => maxZones

int resolvedDevRecalc = switch perfMode
    PerfMode.lite     => 0                       // developing values disabled
    PerfMode.standard => math.max(devRecalcEvery, 5)
    PerfMode.pro      => devRecalcEvery
    => devRecalcEvery

bool devEnabled = showDevPoc and resolvedDevRecalc > 0

// ============================================================================
//  5. THEME
// ============================================================================

bool isDark = switch themeIn
    Theme.dark      => true
    Theme.light     => false
    Theme.autoTheme => color.r(chart.bg_color) + color.g(chart.bg_color) + color.b(chart.bg_color) < 382
    => true

color cText   = isDark ? #d1d4dc : #1f2229
color cMuted  = isDark ? #787b86 : #6a6d78
color cPanel  = isDark ? color.new(#12151c, 12) : color.new(#ffffff, 8)
color cBorder = isDark ? #2a2e39 : #d6d9e0
color cBull   = #26a69a
color cBear   = #ef5350
color cWarn   = #f7a35c
color cAccent = #7e57c2

string dashSizeStr = switch dashSizeIn
    DashSize.tiny   => size.tiny
    DashSize.small  => size.small
    DashSize.normal => size.normal
    DashSize.large  => size.large
    => size.small

string dashPosStr = switch dashPosIn
    DashPos.topLeft      => position.top_left
    DashPos.topCenter    => position.top_center
    DashPos.topRight     => position.top_right
    DashPos.middleLeft   => position.middle_left
    DashPos.middleRight  => position.middle_right
    DashPos.bottomLeft   => position.bottom_left
    DashPos.bottomCenter => position.bottom_center
    DashPos.bottomRight  => position.bottom_right
    => position.top_right

// ============================================================================
//  6. CORE UTILITIES
// ============================================================================

//@function Clamps `v` into [lo, hi].
clamp(float v, float lo, float hi) =>
    math.max(lo, math.min(hi, v))

//@function Exponential decay for event-based scores. age/halfLife -> 0.5^n.
decayFactor(int age, int halfLife) =>
    halfLife <= 0 or age <= 0 ? 1.0 : math.pow(0.5, age / (halfLife * 1.0))

//@function Formats a float for dashboard display, returning "-" for na.
fmt(float v, string f) =>
    na(v) ? "-" : str.tostring(v, f)

//@function Formats a signed score as "+0.00" / "-0.00".
fmtSigned(float v) =>
    na(v) ? "-" : (v >= 0 ? "+" : "") + str.tostring(v, "0.00")

//@function Freezes a value inside an unconfirmed bar when Confirm-on-close is
//          on, so scores cannot flicker tick by tick. This is a display and
//          scoring gate only - it never reaches back into closed bars.
hold(float v) =>
    confirmClose and not barstate.isconfirmed ? nz(v[1], v) : v

//@function Internal assertion. Fails loudly rather than producing silent nonsense.
assert(bool condition, string message) =>
    if dbgAssert and not condition
        runtime.error("ACE internal assertion failed: " + message)

// ============================================================================
//  7. DATA LAYER
// ============================================================================

float atr = ta.atr(atrLen)
float avgVol = ta.sma(volume, rvolLen)
float rvol = avgVol > 0 ? volume / avgVol : na

//@variable True when the instrument actually carries usable volume data.
//          Drives INVARIANT #2: without it, VP and Volume components are INVALID,
//          not neutral, and are excluded from the scoring denominator.
bool volumeValid = not na(volume) and nz(avgVol) > 0

bool isNewDay = timeframe.change("D")
bool isNewWeek = timeframe.change("W")
bool isNewMonth = timeframe.change("M")

//@variable Bar is fully closed (or the user opted into intrabar updates).
bool barConfirmed = confirmClose ? barstate.isconfirmed : true

//@variable Directional volume proxy. NOT order flow - see docs/04-algorithms.md.
float deltaProxy = na
if volumeValid
    if deltaModelIn == DeltaModel.closeDir
        deltaProxy := close > open ? volume : close < open ? -volume : 0.0
    else if deltaModelIn == DeltaModel.closePos
        deltaProxy := high > low ? volume * (2.0 * (close - low) / (high - low) - 1.0) : 0.0
    // D3 (LTF aggregation) and D4 (footprint) arrive in P7 and stay `na` until then.

// ============================================================================
//  8. L3 FOOTPRINT ADAPTER                                    [P7 - not active]
// ----------------------------------------------------------------------------
//  L3 FOOTPRINT ADAPTER - REMOVED IN THE STANDARD BUILD
//
//  This build contains no request.footprint() call and therefore runs on every
//  TradingView plan. The Pro build (build/ACE-Pro.pine) keeps the adapter and
//  requires a Premium or Ultimate plan. Both are generated from src/ACE.pine.

//@function Always false in the Standard build: no footprint data is requested.
fpAvailable() =>
    false

//@function Inert in the Standard build.
fpBarContribution(Profile p) =>
    bool _unused = na(p)
    false

// ============================================================================

// ============================================================================
//  9. DATA SOURCE RESOLUTION
//     The dashboard must always report what was ACTUALLY used, never what was
//     requested. Claiming a more precise source than was available would be the
//     exact kind of dishonesty this project exists to avoid.
// ============================================================================

string resolvedSource = switch dataSrcIn
    DataSource.footprint => fpAvailable() ? "FOOTPRINT" : "BAR (footprint unavailable)"
    DataSource.ltf       => "BAR (LTF arrives in P7)"
    DataSource.barDist   => "BAR"
    DataSource.barClose  => "BAR"
    DataSource.auto      => fpAvailable() ? "FOOTPRINT" : "BAR"
    => "BAR"

string resolvedDeltaSource = switch deltaModelIn
    DeltaModel.closeDir => "D1 proxy"
    DeltaModel.closePos => "D2 proxy"
    DeltaModel.ltfAgg   => "D3 (P7)"
    DeltaModel.fpNative => "D4 (P7)"
    => "unknown"

// ============================================================================
//  10. ENGINE STATE OBJECTS
// ============================================================================

var Profile curProf = Profile.new()
var Profile prvProf = Profile.new()

var array<Swing> swings = array.new<Swing>()
var array<Zone>  zones  = array.new<Zone>()

var EngineState engProfile = EngineState.new("Profile",   false, "P1", "not implemented")
var EngineState engAmt     = EngineState.new("AMT",       false, "P4", "not implemented")
var EngineState engVwap    = EngineState.new("VWAP",      false, "P3", "not implemented")
var EngineState engStruct  = EngineState.new("Structure", false, "P5", "not implemented")
var EngineState engLiq     = EngineState.new("Liquidity", false, "P6", "not implemented")
var EngineState engImb     = EngineState.new("Imbalance", false, "P6", "not implemented")
var EngineState engVol     = EngineState.new("Volume",    false, "P7", "not implemented")

// ============================================================================
//  10b. PROFILE ENGINE                                                    [P1]
// ----------------------------------------------------------------------------
//  DESIGN NOTE - why the grid never gets rebuilt
//
//  The naive approach recomputes the whole profile every bar: O(bars x bins)
//  per bar, which times out on any real history. This engine is ADD-ONLY:
//  each bar contributes once, in O(bins touched by that bar) ~ 1..20.
//
//  A period's bin WIDTH (`step`) is fixed when the period opens and never
//  changes. When price leaves the current grid, the grid is EXTENDED by
//  pushing/unshifting empty bins - existing bins keep their exact contents.
//  There is no redistribution and therefore no accumulated rounding error.
//  Extension is capped; if the cap is hit, `clamped` is set and the dashboard
//  says so rather than silently mis-binning the tails.
//
//  FACT ONLY: this engine emits POC, VAH, VAL, node lists and a position
//  measure. It never decides whether any of that is bullish. See INVARIANT #1.
// ============================================================================

//@function Lower price boundary of bin `i`.
pBinLow(Profile p, int i) =>
    p.lo + i * p.step

//@function Mid price of bin `i`.
pBinMid(Profile p, int i) =>
    p.lo + (i + 0.5) * p.step

//@function Upper price boundary of bin `i`.
pBinHigh(Profile p, int i) =>
    p.lo + (i + 1) * p.step

//@function Bin index containing `price` (may be out of range; callers guard).
pIndexOf(Profile p, float price) =>
    p.step > 0 ? int(math.floor((price - p.lo) / p.step)) : 0

//@function Opens a fresh profile centred on `center`, with a fixed bin width.
profOpen(float center, float step, int bins, int startBar) =>
    Profile p = Profile.new()
    p.step     := step
    p.bins     := bins
    p.lo       := center - (bins / 2.0) * step
    p.hi       := p.lo + bins * step
    p.vol      := array.new<float>(bins, 0.0)
    p.volUp    := array.new<float>(bins, 0.0)
    p.volDn    := array.new<float>(bins, 0.0)
    p.tpo      := array.new<float>(bins, 0.0)
    p.total    := 0.0
    p.tpoTotal := 0.0
    p.startBar := startBar
    p.endBar   := startBar
    p.clamped  := false
    p.ready    := false
    p.model    := "BAR"
    p

//@function Grows the grid so it covers [lo, hi]. Existing bins are untouched.
profExtend(Profile p, float lo, float hi, int maxBins) =>
    if p.bins > 0 and p.step > 0
        if lo < p.lo
            int need = int(math.ceil((p.lo - lo) / p.step))
            int room = math.max(0, maxBins - p.bins)
            int add  = math.min(need, room)
            if add > 0
                for i = 1 to add
                    array.unshift(p.vol,   0.0)
                    array.unshift(p.volUp, 0.0)
                    array.unshift(p.volDn, 0.0)
                    array.unshift(p.tpo,   0.0)
                p.lo   := p.lo - add * p.step
                p.bins := p.bins + add
            if add < need
                p.clamped := true
        if hi >= p.lo + p.bins * p.step
            int need = int(math.floor((hi - (p.lo + p.bins * p.step)) / p.step)) + 1
            int room = math.max(0, maxBins - p.bins)
            int add  = math.min(need, room)
            if add > 0
                for i = 1 to add
                    array.push(p.vol,   0.0)
                    array.push(p.volUp, 0.0)
                    array.push(p.volDn, 0.0)
                    array.push(p.tpo,   0.0)
                p.bins := p.bins + add
            if add < need
                p.clamped := true
        p.hi := p.lo + p.bins * p.step

//@function Adds one value to a bin, guarding the index.
profBump(Profile p, int i, float vol, float up, float dn, float tpo) =>
    if i >= 0 and i < p.bins
        array.set(p.vol,   i, array.get(p.vol,   i) + vol)
        array.set(p.volUp, i, array.get(p.volUp, i) + up)
        array.set(p.volDn, i, array.get(p.volDn, i) + dn)
        array.set(p.tpo,   i, array.get(p.tpo,   i) + tpo)

//@function Contributes the current bar to the profile.
//@param    dlt Directional volume proxy, or na when unavailable.
profAddBar(Profile p, float o, float h, float l, float c, float v, float dlt, DistModel model, int maxBins, int maxBinsPerBar) =>
    profExtend(p, l, h, maxBins)

    int iLo = math.max(0, pIndexOf(p, l))
    int iHi = math.min(p.bins - 1, pIndexOf(p, h))
    float barVol = nz(v)

    // Directional split: up + dn = volume, up - dn = delta.
    bool  dOk = not na(dlt)
    float upTot = dOk ? math.max(0.0, (barVol + dlt) / 2.0) : 0.0
    float dnTot = dOk ? math.max(0.0, (barVol - dlt) / 2.0) : 0.0

    bool degenerate = iHi < iLo or h <= l
    // Defensive: a single bar spanning an absurd number of bins would make the
    // per-bar loop the dominant cost. Fall back to close-only and say so.
    bool tooWide = (iHi - iLo) > maxBinsPerBar
    if tooWide
        p.clamped := true

    if model == DistModel.closeOnly or degenerate or tooWide
        int i = math.max(0, math.min(p.bins - 1, pIndexOf(p, c)))
        profBump(p, i, barVol, upTot, dnTot, 1.0)
    else
        float mid = (h + l + c) / 3.0
        float half = (h - l) / 2.0
        // Pass 1: total weight, so the bar contributes exactly `barVol`.
        float wSum = 0.0
        for i = iLo to iHi
            float ov = math.min(pBinHigh(p, i), h) - math.max(pBinLow(p, i), l)
            if ov > 0
                float w = ov / (h - l)
                if model == DistModel.weighted and half > 0
                    // Triangular emphasis around the bar's typical price.
                    w := w * math.max(0.05, 1.0 - math.abs(pBinMid(p, i) - mid) / half)
                wSum += w
        // Pass 2: apply normalised weights.
        if wSum > 0
            for i = iLo to iHi
                float ov = math.min(pBinHigh(p, i), h) - math.max(pBinLow(p, i), l)
                if ov > 0
                    float w = ov / (h - l)
                    if model == DistModel.weighted and half > 0
                        w := w * math.max(0.05, 1.0 - math.abs(pBinMid(p, i) - mid) / half)
                    float k = w / wSum
                    profBump(p, i, barVol * k, upTot * k, dnTot * k, 1.0)

    p.total    := p.total + barVol
    p.tpoTotal := p.tpoTotal + (iHi >= iLo ? iHi - iLo + 1 : 1)
    p.endBar   := bar_index

//@function Point of Control. Ties resolve to the bin nearest `refPrice`, then
//          to the lower index - deterministic, so the POC does not jitter.
profPoc(Profile p, array<float> src, float refPrice) =>
    int best = -1
    float bestV = -1.0
    if src.size() > 0
        for i = 0 to src.size() - 1
            float v = array.get(src, i)
            if v > bestV
                bestV := v
                best  := i
            else if v == bestV and best >= 0 and v > 0
                if math.abs(pBinMid(p, i) - refPrice) < math.abs(pBinMid(p, best) - refPrice)
                    best := i
    best

//@function Classic CBOT Value Area: expand from the POC two bins at a time,
//          always taking the heavier side, until `vaPct` of volume is covered.
profVaClassic(array<float> src, int pocIdx, float total, float vaPct) =>
    int n = src.size()
    int loIdx = pocIdx
    int hiIdx = pocIdx
    if n > 0 and pocIdx >= 0 and total > 0
        float target = total * vaPct / 100.0
        float acc = array.get(src, pocIdx)
        int up = pocIdx + 1
        int dn = pocIdx - 1
        int guard = 0
        while acc < target and (up < n or dn >= 0) and guard < n
            guard += 1
            bool canUp = up < n
            bool canDn = dn >= 0
            float vUp = (canUp ? array.get(src, up) : 0.0) + (up + 1 < n ? array.get(src, up + 1) : 0.0)
            float vDn = (canDn ? array.get(src, dn) : 0.0) + (dn - 1 >= 0 ? array.get(src, dn - 1) : 0.0)
            if canUp and (not canDn or vUp >= vDn)
                acc   += vUp
                hiIdx := math.min(up + 1, n - 1)
                up    += 2
            else if canDn
                acc   += vDn
                loIdx := math.max(dn - 1, 0)
                dn    -= 2
            else
                break
    [loIdx, hiIdx]

//@function Alternative: take the highest-volume bins until the target is met.
//          May select non-contiguous bins, so it will NOT match a standard
//          profile. Offered as an explicit option, never as the default.
profVaSorted(array<float> src, float total, float vaPct) =>
    int n = src.size()
    int loIdx = 0
    int hiIdx = n > 0 ? n - 1 : 0
    if n > 0 and total > 0
        // Find the volume cutoff by walking a sorted copy, then select every
        // bin at or above it. Uses only array.copy/array.sort, and avoids
        // building an index permutation.
        array<float> ranked = array.copy(src)
        array.sort(ranked, order.descending)
        float target = total * vaPct / 100.0
        float acc = 0.0
        float cutoff = 0.0
        for k = 0 to n - 1
            float v = array.get(ranked, k)
            acc += v
            cutoff := v
            if acc >= target
                break
        int mn = n
        int mx = -1
        for i = 0 to n - 1
            if array.get(src, i) >= cutoff and array.get(src, i) > 0
                mn := math.min(mn, i)
                mx := math.max(mx, i)
        loIdx := mx >= 0 ? mn : 0
        hiIdx := mx >= 0 ? mx : (n - 1)
    [loIdx, hiIdx]

//@function Computes POC / VAH / VAL for a profile from the chosen source array.
profFinalize(Profile p, bool useTpo, VaAlgo algo, float vaPct, float refPrice) =>
    array<float> src = useTpo ? p.tpo : p.vol
    float total = useTpo ? p.tpoTotal : p.total
    if p.bins > 0 and total > 0
        int pocIdx = profPoc(p, src, refPrice)
        if pocIdx >= 0
            int loIdx = pocIdx
            int hiIdx = pocIdx
            if algo == VaAlgo.classic
                [a, b] = profVaClassic(src, pocIdx, total, vaPct)
                loIdx := a
                hiIdx := b
            else
                [a, b] = profVaSorted(src, total, vaPct)
                loIdx := a
                hiIdx := b
            p.poc   := pBinMid(p, pocIdx)
            p.val   := pBinLow(p, loIdx)
            p.vah   := pBinHigh(p, hiIdx)
            p.ready := true

//@function Marks bins that are local volume maxima (HVN) or minima (LVN).
//@returns  An array of ints: 1 = HVN, -1 = LVN, 0 = neither.
profNodes(Profile p, bool useTpo, int win, float hiThr, float loThr) =>
    array<float> src = useTpo ? p.tpo : p.vol
    int n = src.size()
    array<int> tags = array.new<int>(n, 0)
    if n > 2
        float mx = array.max(src)
        if mx > 0
            for i = 0 to n - 1
                float v = array.get(src, i) / mx
                int a = math.max(0, i - win)
                int b = math.min(n - 1, i + win)
                bool isMax = true
                bool isMin = true
                for j = a to b
                    float u = array.get(src, j) / mx
                    if u > v
                        isMax := false
                    if u < v
                        isMin := false
                if isMax and v >= hiThr
                    array.set(tags, i, 1)
                else if isMin and v <= loThr and v > 0
                    array.set(tags, i, -1)
    tags

// ---- profile period handling ----------------------------------------------

//@variable True on the first bar of a new profile period.
bool isNewPeriod = switch profAnchor
    ProfileAnchor.session => isNewDay
    ProfileAnchor.daily   => isNewDay
    ProfileAnchor.weekly  => isNewWeek
    ProfileAnchor.monthly => isNewMonth
    ProfileAnchor.fixed   => bar_index % math.max(1, profileLookback) == 0
    => isNewDay

//@variable Effective profile source: TPO is forced when volume is unusable.
bool useTpoSrc = showTpo or not volumeValid

//@variable Hard ceiling on bins per profile, protecting memory and loop time.
int binCapHard = math.min(500, resolvedBins * 4)

if isNewPeriod or curProf.bins == 0
    if curProf.bins > 0
        // Close the outgoing profile and keep it as the previous one.
        profFinalize(curProf, useTpoSrc, vaAlgo, vaPercent, close)
        prvProf := curProf
    float stepRaw = nz(atr, syminfo.mintick * 10) * profRangeAtr / math.max(1, resolvedBins)
    float step = math.max(syminfo.mintick, math.round(stepRaw / syminfo.mintick) * syminfo.mintick)
    curProf := profOpen(close, step, resolvedBins, bar_index)

if curProf.bins > 0
    profAddBar(curProf, open, high, low, close, volume, deltaProxy, distModel,
         binCapHard, maxBinsPerBar)
    curProf.model := resolvedSource

// Developing POC / VA: recomputed on a schedule, not every tick.
var float devPoc = na
var float devVah = na
var float devVal = na

bool devDue = devEnabled and (bar_index - curProf.startBar) % math.max(1, resolvedDevRecalc) == 0
if curProf.bins > 0 and (devDue or barstate.islast)
    profFinalize(curProf, useTpoSrc, vaAlgo, vaPercent, close)
    devPoc := curProf.poc
    devVah := curProf.vah
    devVal := curProf.val

if isNewPeriod
    devPoc := na
    devVah := na
    devVal := na

engProfile.ready := curProf.ready
if curProf.ready
    engProfile.summary := str.tostring(curProf.bins) + " bins, " + (useTpoSrc ? "TPO" : "VOL") + (curProf.clamped ? ", CLAMPED" : "")
else
    engProfile.summary := "warming up"

// ---- FACT: position of price relative to developed value -------------------

//@variable Continuous position of price in the value structure.
//          Inside the VA: -0.5 .. +0.5 around the POC.
//          Outside: saturates toward +/-1 at half a VA width beyond the edge.
//          This is a MEASUREMENT. Whether it is bullish is decided elsewhere.
float valuePos = na
string valueState = "-"
if curProf.ready and not na(curProf.vah) and not na(curProf.val) and curProf.vah > curProf.val
    float vaWidth = curProf.vah - curProf.val
    if close > curProf.vah
        valuePos := 0.5 + 0.5 * math.min((close - curProf.vah) / (0.5 * vaWidth), 1.0)
        valueState := "Above VAH"
    else if close < curProf.val
        valuePos := -0.5 - 0.5 * math.min((curProf.val - close) / (0.5 * vaWidth), 1.0)
        valueState := "Below VAL"
    else
        valuePos := clamp((close - curProf.poc) / vaWidth, -0.5, 0.5)
        valueState := close > curProf.poc ? "In value (above POC)" :
                      close < curProf.poc ? "In value (below POC)" : "At POC"

// ============================================================================
//  10c. VWAP ENGINE                                                       [P3]
// ----------------------------------------------------------------------------
//  ACCUMULATION - why the second moment, not a running deviation
//
//  The standard deviation of a VWAP must be volume weighted around the FINAL
//  mean, not around the mean as it was when each bar arrived. Accumulating
//  (src - vwap_running)^2 understates the band width systematically, because
//  early bars are measured against a mean that no longer exists.
//
//  This engine accumulates raw weighted moments instead:
//
//      sumV   = SUM(v)
//      sumPV  = SUM(src * v)
//      sumP2V = SUM(src^2 * v)
//
//      vwap   = sumPV / sumV
//      var    = sumP2V / sumV - vwap^2          (weighted second moment)
//      sigma  = sqrt(max(var, 0))
//
//  Every bar therefore contributes exactly once, in O(1), and the deviation is
//  always measured against the current mean. `max(var, 0)` guards the one real
//  hazard of this identity: catastrophic cancellation when the two terms are
//  nearly equal can produce a tiny negative variance.
//
//  FACT ONLY: this engine emits prices, a sigma, a z-score and a position
//  label. It does not decide whether being above the VWAP is bullish.
// ============================================================================

//@type One VWAP accumulator: an anchor plus its weighted moments.
type VwapAcc
    float sumPV    = 0.0
    float sumV     = 0.0
    float sumP2V   = 0.0
    float vwap     = na
    float sd       = na
    int   anchorBar = na
    bool  active   = false
    bool  valid    = false

//@variable Price series the VWAP is weighted on. hlc3 matches `ta.vwap`.
float vwapSrc = switch vwapSrcIn
    VwapSource.hlc3  => hlc3
    VwapSource.close => close
    VwapSource.hl2   => hl2
    VwapSource.ohlc4 => ohlc4
    => hlc3

//@function Clears an accumulator and anchors it to the current bar.
vwapReset(VwapAcc a) =>
    a.sumPV     := 0.0
    a.sumV      := 0.0
    a.sumP2V    := 0.0
    a.vwap      := na
    a.sd        := na
    a.anchorBar := bar_index
    a.active    := true
    a.valid     := false

//@function Adds one bar to an accumulator and refreshes vwap / sigma.
vwapAdd(VwapAcc a, float src, float vol) =>
    if a.active and not na(src) and not na(vol) and vol > 0
        a.sumPV  := a.sumPV + src * vol
        a.sumV   := a.sumV + vol
        a.sumP2V := a.sumP2V + src * src * vol
        if a.sumV > 0
            a.vwap := a.sumPV / a.sumV
            float m2 = a.sumP2V / a.sumV
            a.sd    := math.sqrt(math.max(m2 - a.vwap * a.vwap, 0.0))
            a.valid := true

//@function Rebuilds an accumulator from `back` bars ago up to the current bar.
//          Used by anchors that can move (highest high, lowest low).
vwapRebuild(VwapAcc a, int back) =>
    a.sumPV     := 0.0
    a.sumV      := 0.0
    a.sumP2V    := 0.0
    a.vwap      := na
    a.sd        := na
    a.anchorBar := bar_index - back
    a.active    := true
    a.valid     := false
    if back >= 0
        for i = back to 0
            float s = vwapSrc[i]
            float v = nz(volume[i])
            if not na(s) and v > 0
                a.sumPV  := a.sumPV + s * v
                a.sumV   := a.sumV + v
                a.sumP2V := a.sumP2V + s * s * v
        if a.sumV > 0
            a.vwap := a.sumPV / a.sumV
            float m2 = a.sumP2V / a.sumV
            a.sd    := math.sqrt(math.max(m2 - a.vwap * a.vwap, 0.0))
            a.valid := true

// ---- period anchors --------------------------------------------------------
// All of these look only at the CURRENT and PREVIOUS bar. No lookahead, no
// request.security(), so nothing here can leak future data.

//@variable New trading session / day, as `ta.vwap` defines it.
bool vwapNewSession = na(time[1]) or time("D") != time("D")[1]
//@variable New CALENDAR day in exchange time. On 24h instruments this
//          coincides with the session anchor; on futures with an evening open
//          it genuinely differs, which is the whole point of having both.
bool vwapNewCalDay = na(time[1]) or dayofmonth != dayofmonth[1]
bool vwapNewWeek = na(time[1]) or time("W") != time("W")[1]
bool vwapNewMonth = na(time[1]) or time("M") != time("M")[1]

var VwapAcc accSession = VwapAcc.new()
var VwapAcc accDaily   = VwapAcc.new()
var VwapAcc accWeekly  = VwapAcc.new()
var VwapAcc accMonthly = VwapAcc.new()
var VwapAcc accAnc1    = VwapAcc.new()
var VwapAcc accAnc2    = VwapAcc.new()

if vwapNewSession
    vwapReset(accSession)
if vwapNewCalDay
    vwapReset(accDaily)
if vwapNewWeek
    vwapReset(accWeekly)
if vwapNewMonth
    vwapReset(accMonthly)

vwapAdd(accSession, vwapSrc, volume)
vwapAdd(accDaily,   vwapSrc, volume)
vwapAdd(accWeekly,  vwapSrc, volume)
vwapAdd(accMonthly, vwapSrc, volume)

// ---- anchored VWAP ---------------------------------------------------------

//@function Applies one anchor mode to an accumulator.
//@returns  A status string: "ok", or why the anchor produced no data.
vwapApplyAnchor(VwapAcc a, AnchorMode mode, int anchorTime, int lookback) =>
    string status = "ok"
    if mode == AnchorMode.dateTime
        if time >= anchorTime and (na(time[1]) or time[1] < anchorTime)
            vwapReset(a)
        if not a.active
            status := "waiting for anchor date"
        vwapAdd(a, vwapSrc, volume)
    else if mode == AnchorMode.sessionOpen
        if vwapNewSession
            vwapReset(a)
        vwapAdd(a, vwapSrc, volume)
    else if mode == AnchorMode.weekOpen
        if vwapNewWeek
            vwapReset(a)
        vwapAdd(a, vwapSrc, volume)
    else if mode == AnchorMode.monthOpen
        if vwapNewMonth
            vwapReset(a)
        vwapAdd(a, vwapSrc, volume)
    else if mode == AnchorMode.yearOpen
        if na(time[1]) or year != year[1]
            vwapReset(a)
        vwapAdd(a, vwapSrc, volume)
    else if mode == AnchorMode.highestHigh
        int back = int(math.abs(nz(ta.highestbars(high, lookback), 0)))
        if na(a.anchorBar) or bar_index - back != a.anchorBar
            vwapRebuild(a, back)
        else
            vwapAdd(a, vwapSrc, volume)
    else if mode == AnchorMode.lowestLow
        int back = int(math.abs(nz(ta.lowestbars(low, lookback), 0)))
        if na(a.anchorBar) or bar_index - back != a.anchorBar
            vwapRebuild(a, back)
        else
            vwapAdd(a, vwapSrc, volume)
    else
        // Structure-based anchors are honest about not existing yet.
        status := "needs Structure Engine (P5)"
    status

string anc1Status = useAnchored1 ? vwapApplyAnchor(accAnc1, anc1Mode, anc1Time, anc1Lookback) : "off"
string anc2Status = useAnchored2 ? vwapApplyAnchor(accAnc2, anc2Mode, anc2Time, anc2Lookback) : "off"

// ---- primary VWAP selection ------------------------------------------------

//@function Picks the accumulator the bands, z-score and score refer to.
vwapPrimary() =>
    VwapAcc a = accSession
    if primaryVwap == PrimaryVwap.daily
        a := accDaily
    else if primaryVwap == PrimaryVwap.weekly
        a := accWeekly
    else if primaryVwap == PrimaryVwap.monthly
        a := accMonthly
    else if primaryVwap == PrimaryVwap.anchor1
        a := accAnc1
    else if primaryVwap == PrimaryVwap.anchor2
        a := accAnc2
    a

VwapAcc primary = vwapPrimary()

//@variable The primary VWAP is usable only with real volume behind it.
//          Without volume a "VWAP" is just a moving average of price and must
//          not be presented as a VWAP - it reports NO DATA instead.
bool vwapValid = volumeValid and primary.valid and not na(primary.vwap)

float vwapVal = vwapValid ? primary.vwap : na
float vwapSd  = vwapValid ? primary.sd : na

// σ bands. Percentage mode is offered for instruments where a volume-weighted
// sigma is degenerate (very low trade counts per bar).
vwapBand(float mult, int sign) =>
    float r = na
    if vwapValid
        if bandMode == BandMode.stdev
            r := not na(vwapSd) ? vwapVal + sign * mult * vwapSd : na
        else
            r := vwapVal * (1.0 + sign * mult / 100.0)
    r

float bandU1 = vwapBand(vwapDev1, 1)
float bandL1 = vwapBand(vwapDev1, -1)
float bandU2 = vwapBand(vwapDev2, 1)
float bandL2 = vwapBand(vwapDev2, -1)
float bandU3 = vwapBand(vwapDev3, 1)
float bandL3 = vwapBand(vwapDev3, -1)

// ---- FACT outputs ----------------------------------------------------------

//@variable Standardised distance of price from the VWAP. na when sigma is 0,
//          which happens on the anchor bar itself - that is NO DATA, not 0.
float vwapZ = vwapValid and not na(vwapSd) and vwapSd > 0 ? (close - vwapVal) / vwapSd : na

//@variable Which sigma band price currently occupies.
string vwapZone = "-"
if not na(vwapZ)
    float az = math.abs(vwapZ)
    string side = vwapZ > 0 ? "above" : "below"
    if az <= vwapDev1
        vwapZone := "inside " + str.tostring(vwapDev1, "0.#") + " sigma"
    else if az <= vwapDev2
        vwapZone := str.tostring(vwapDev1, "0.#") + "-" + str.tostring(vwapDev2, "0.#") + " sigma " + side
    else if az <= vwapDev3
        vwapZone := str.tostring(vwapDev2, "0.#") + "-" + str.tostring(vwapDev3, "0.#") + " sigma " + side
    else
        vwapZone := "beyond " + str.tostring(vwapDev3, "0.#") + " sigma " + side

//@variable Plain position of price relative to the VWAP.
string vwapPos = not vwapValid ? "-" : close > vwapVal ? "Above" : close < vwapVal ? "Below" : "At"

// ---- built-in cross-check --------------------------------------------------
// `ta.vwap` is the reference implementation. Keeping a live difference readout
// in the debug panel makes the accuracy claim verifiable by the user instead
// of something they have to take on trust.
float refVwap = volumeValid ? ta.vwap(hlc3) : na
float vwapDiffTicks = not na(refVwap) and accSession.valid and syminfo.mintick > 0 ?
     math.abs(accSession.vwap - refVwap) / syminfo.mintick : na

engVwap.ready := vwapValid
if vwapValid
    engVwap.summary := str.tostring(primary.vwap, format.mintick) + ", σ " + str.tostring(nz(vwapSd), format.mintick)
else
    engVwap.summary := volumeValid ? "warming up" : "no volume data"

// ============================================================================
//  11. CONTEXT ENGINE
//      Turns engine FACTS into normalised component scores in [-1, +1].
//      A component with no data reports valid = false and is excluded from the
//      scoring denominator entirely (INVARIANT #2).
// ============================================================================

//@variable Human-readable name of the VWAP the score refers to.
string primaryName = switch primaryVwap
    PrimaryVwap.session => "Session"
    PrimaryVwap.daily   => "Daily"
    PrimaryVwap.weekly  => "Weekly"
    PrimaryVwap.monthly => "Monthly"
    PrimaryVwap.anchor1 => "Anchored #1"
    PrimaryVwap.anchor2 => "Anchored #2"
    => "Session"

//@variable Why the primary VWAP has no data, when it has none.
string primaryStatus = switch primaryVwap
    PrimaryVwap.anchor1 => useAnchored1 ? anc1Status : "Anchored #1 is off"
    PrimaryVwap.anchor2 => useAnchored2 ? anc2Status : "Anchored #2 is off"
    => volumeValid ? "warming up" : "no volume data"

// FACT values gated by Confirm-on-bar-close before they reach the score.
float valuePosHeld = hold(valuePos)
float vwapZHeld    = hold(vwapZ)

buildComponents() =>
    array<Component> c = array.new<Component>()

    c.push(Component.new(name = "AMT", weight = wAmt, enabled = enAmt,
         state = "-", reason = "engine arrives in P4"))

    // --- Volume Profile: live as of P1 ---
    Component vp = Component.new(name = "Volume Prof.", weight = wVp, enabled = enVp)
    if not na(valuePosHeld)
        vp.valid  := true
        vp.raw    := clamp(valuePosHeld, -1.0, 1.0)
        vp.state  := valueState
        vp.approx := resolvedSource == "FOOTPRINT"
        vp.reason := (useTpoSrc ? "TPO" : "volume") + " profile, POC " +
             str.tostring(curProf.poc, format.mintick)
    else
        vp.state  := "-"
        vp.reason := curProf.bins > 0 ? "profile warming up" : "no profile"
    c.push(vp)

    c.push(Component.new(name = "Structure", weight = wStruct, enabled = enStruct,
         state = "-", reason = "engine arrives in P5"))

    // --- VWAP: live as of P3 ---
    Component vw = Component.new(name = "VWAP", weight = wVwap, enabled = enVwap)
    if not na(vwapZHeld)
        vw.valid  := true
        vw.raw    := clamp(vwapZHeld / zSaturation, -1.0, 1.0)
        vw.state  := vwapPos + " " + str.tostring(vwapZHeld, "0.0") + " sigma"
        vw.reason := primaryName + " VWAP " + str.tostring(vwapVal, format.mintick) + ", " + vwapZone
    else
        vw.state  := "-"
        // NO DATA != NEUTRAL: say which of the several reasons applies.
        vw.reason := not volumeValid ? "no volume data (VWAP undefined)" : primaryStatus
    c.push(vw)

    c.push(Component.new(name = "Liquidity", weight = wLiq, enabled = enLiq,
         state = "-", reason = "engine arrives in P6"))
    c.push(Component.new(name = "Imbalance", weight = wImb, enabled = enImb,
         state = "-", reason = "engine arrives in P6"))
    c.push(Component.new(name = "Volume", weight = wVol, enabled = enVol,
         state = "-", reason = "engine arrives in P7"))
    c

// ============================================================================
//  12. SCORING ENGINE
//      bias      = SUM(w*s) / SUM(w)      over ACTIVE components only
//      coverage  = active / enabled       -> how much of the model has data
//      agreement = |SUM(w*s)| / SUM(w|s|) -> do the components agree
//      strength  = SUM(w|s|) / SUM(w)     -> are the signals pronounced at all
//      confidence = coverage * agreement * strength
//
//      Confidence is an INTERNAL MODEL AGREEMENT measure. It is not, and must
//      never be presented as, a probability of price moving in any direction.
// ============================================================================

calcScore(array<Component> comps) =>
    float wSum     = 0.0
    float wsSum    = 0.0
    float wAbsSSum = 0.0
    float bullAcc  = 0.0
    float bearAcc  = 0.0
    int   active   = 0
    int   enabled  = 0

    for c in comps
        if c.enabled and c.weight > 0
            enabled += 1
            if c.valid
                active   += 1
                wSum     += c.weight
                wsSum    += c.weight * c.raw
                wAbsSSum += c.weight * math.abs(c.raw)
                bullAcc  += c.weight * math.max(c.raw, 0.0)
                bearAcc  += c.weight * math.max(-c.raw, 0.0)

    ScoreResult r = ScoreResult.new()
    r.enabledCount := enabled
    r.activeCount  := active

    if wSum > 0
        r.bias      := wsSum / wSum
        r.bull      := bullAcc / wSum
        r.bear      := bearAcc / wSum
        r.coverage  := enabled > 0 ? active / (enabled * 1.0) : 0.0
        r.agreement := wAbsSSum > 0 ? math.abs(wsSum) / wAbsSSum : 0.0
        r.strength  := wAbsSSum / wSum
        r.confidence := r.coverage * r.agreement * r.strength

        float ab = math.abs(r.bias)
        string dir = r.bias >= 0 ? "BULLISH" : "BEARISH"
        r.label := ab < thrNeutral ? "NEUTRAL / BALANCE" :
                   ab < thrWeak    ? "WEAK " + dir :
                   ab < thrStrong  ? "MODERATE " + dir : "STRONG " + dir

        if r.confidence < minConfidence and ab >= thrNeutral
            r.label := "NEUTRAL - CONFLICTED"
    else
        // INVARIANT #2: no active component is NOT a neutral market read.
        r.label := "NO DATA"

    r

array<Component> components = buildComponents()
ScoreResult score = calcScore(components)

// Previous-bar contributions, for the "what changed" explanation.
var array<float> prevContrib = array.new<float>(7, 0.0)

// ============================================================================
//  13. DASHBOARD
// ============================================================================

var table dash = table.new(dashPosStr, 5, 26, bgcolor = cPanel,
     border_color = cBorder, border_width = 1, frame_color = cBorder, frame_width = 1)

//@function Writes one dashboard cell.
dcell(int col, int row, string txt, color txtColor, string align) =>
    table.cell(dash, col, row, txt, text_color = txtColor, text_size = dashSizeStr,
         text_halign = align, bgcolor = color.new(color.black, 100))

renderDashboard() =>
    table.clear(dash, 0, 0, 4, 25)
    int r = 0

    // ---- header
    dcell(0, r, ACE_SHORT + " · MARKET CONTEXT", cText, text.align_left)
    dcell(4, r, syminfo.ticker + " · " + timeframe.period, cMuted, text.align_right)
    r += 1

    // ---- component breakdown
    if dashBreakdown
        dcell(0, r, "COMPONENT", cMuted, text.align_left)
        dcell(1, r, "STATE", cMuted, text.align_left)
        dcell(2, r, "SCORE", cMuted, text.align_right)
        dcell(3, r, dashWeights ? "W" : "", cMuted, text.align_right)
        dcell(4, r, dashWeights ? "CONTRIB" : "", cMuted, text.align_right)
        r += 1

        for c in components
            if c.enabled
                bool on = c.valid
                color sc = not on ? cMuted : c.raw > 0 ? cBull : c.raw < 0 ? cBear : cText
                float contrib = on and score.activeCount > 0 ? c.weight * c.raw : na
                dcell(0, r, c.name + (c.approx ? " ~" : ""), on ? cText : cMuted, text.align_left)
                dcell(1, r, on ? c.state : "NO DATA", on ? cText : cWarn, text.align_left)
                dcell(2, r, on ? fmtSigned(c.raw) : "-", sc, text.align_right)
                dcell(3, r, dashWeights ? str.tostring(c.weight, "0.0") : "", cMuted, text.align_right)
                dcell(4, r, dashWeights ? (on ? fmtSigned(contrib) : "-") : "", sc, text.align_right)
                r += 1

    // ---- summary
    bool hasData = score.activeCount > 0
    color biasColor = not hasData ? cWarn : score.bias > 0 ? cBull : score.bias < 0 ? cBear : cText

    dcell(0, r, "BULL", cMuted, text.align_left)
    dcell(1, r, hasData ? str.tostring(score.bull, "0.00") : "-", cBull, text.align_left)
    dcell(2, r, "BEAR", cMuted, text.align_right)
    dcell(3, r, hasData ? str.tostring(score.bear, "0.00") : "-", cBear, text.align_right)
    dcell(4, r, "", cMuted, text.align_right)
    r += 1

    dcell(0, r, "BIAS", cMuted, text.align_left)
    dcell(1, r, hasData ? fmtSigned(score.bias) : "-", biasColor, text.align_left)
    dcell(2, r, "CONFIDENCE", cMuted, text.align_right)
    dcell(3, r, hasData ? str.tostring(math.round(score.confidence * 100)) + "%" : "-", cText, text.align_right)
    dcell(4, r, str.tostring(score.activeCount) + "/" + str.tostring(score.enabledCount), cMuted, text.align_right)
    r += 1

    dcell(0, r, "CONTEXT", cMuted, text.align_left)
    dcell(1, r, score.label, biasColor, text.align_left)
    dcell(2, r, "", cText, text.align_right)
    dcell(3, r, "", cText, text.align_right)
    dcell(4, r, "", cText, text.align_right)
    r += 1

    if dashChanged
        dcell(0, r, "WHAT CHANGED", cMuted, text.align_left)
        dcell(1, r, hasData ? "-" : "no active components", cMuted, text.align_left)
        dcell(2, r, "", cMuted, text.align_right)
        dcell(3, r, "", cMuted, text.align_right)
        dcell(4, r, "", cMuted, text.align_right)
        r += 1

    // ---- levels (always shown: makes the score hand-verifiable)
    dcell(0, r, "LEVELS", cMuted, text.align_left)
    dcell(1, r, "POC " + fmt(curProf.poc, format.mintick), cText, text.align_left)
    dcell(2, r, "VAH " + fmt(curProf.vah, format.mintick), cText, text.align_right)
    dcell(3, r, "VAL " + fmt(curProf.val, format.mintick), cText, text.align_right)
    dcell(4, r, "ATR " + fmt(atr, format.mintick), cMuted, text.align_right)
    r += 1

    dcell(0, r, "VWAP", cMuted, text.align_left)
    dcell(1, r, vwapValid ? primaryName + " " + str.tostring(vwapVal, format.mintick) : "-",
         vwapValid ? cText : cMuted, text.align_left)
    dcell(2, r, "σ", cMuted, text.align_right)
    dcell(3, r, fmt(vwapSd, format.mintick), cText, text.align_right)
    dcell(4, r, vwapZone, cMuted, text.align_right)
    r += 1

    dcell(0, r, "VALUE", cMuted, text.align_left)
    dcell(1, r, valueState, na(valuePos) ? cMuted : valuePos > 0 ? cBull : valuePos < 0 ? cBear : cText, text.align_left)
    dcell(2, r, "DEV POC", cMuted, text.align_right)
    dcell(3, r, fmt(devPoc, format.mintick), cText, text.align_right)
    dcell(4, r, curProf.ready ? str.tostring(curProf.bins) + " bins" : "warming up", cMuted, text.align_right)
    r += 1

    // ---- data quality (never optional: the user must always know the source)
    dcell(0, r, "PROFILE DATA", cMuted, text.align_left)
    dcell(1, r, resolvedSource, resolvedSource == "FOOTPRINT" ? cWarn : cText, text.align_left)
    dcell(2, r, "VOLUME", cMuted, text.align_right)
    dcell(3, r, volumeValid ? "OK" : "MISSING", volumeValid ? cBull : cWarn, text.align_right)
    dcell(4, r, useTpoSrc ? "TPO" : "VOL", useTpoSrc ? cWarn : cMuted, text.align_right)
    r += 1

    if curProf.clamped
        dcell(0, r, "WARNING", cWarn, text.align_left)
        dcell(1, r, "Profile grid clamped - tails may be mis-binned", cWarn, text.align_left)
        dcell(2, r, "", cWarn, text.align_right)
        dcell(3, r, "", cWarn, text.align_right)
        dcell(4, r, "", cWarn, text.align_right)
        r += 1

    dcell(0, r, "INTEGRITY", cMuted, text.align_left)
    dcell(1, r, confirmClose ? "Confirmed on bar close" : "Intrabar (live updates)",
         confirmClose ? cBull : cWarn, text.align_left)
    dcell(2, r, "No lookahead", cBull, text.align_right)
    dcell(3, r, ACE_VERSION + " " + ACE_BUILD, cMuted, text.align_right)
    dcell(4, r, ACE_PHASE, cMuted, text.align_right)
    r += 1

// ============================================================================
//  14. DEBUG FRAMEWORK
// ============================================================================

var table dbg = table.new(position.bottom_left, 3, 40, bgcolor = cPanel,
     border_color = cBorder, border_width = 1, frame_color = cBorder, frame_width = 1)

dbgRow(int row, string k, string v, color vc) =>
    table.cell(dbg, 0, row, k, text_color = cMuted, text_size = size.tiny, text_halign = text.align_left)
    table.cell(dbg, 1, row, v, text_color = vc, text_size = size.tiny, text_halign = text.align_left)

dbgEngineRow(int row, EngineState e) =>
    table.cell(dbg, 0, row, e.name, text_color = cMuted, text_size = size.tiny, text_halign = text.align_left)
    table.cell(dbg, 1, row, e.ready ? "READY" : "PENDING", e.ready ? cBull : cWarn,
         text_size = size.tiny, text_halign = text.align_left)
    table.cell(dbg, 2, row, e.phase + " · " + e.summary, cMuted, text_size = size.tiny, text_halign = text.align_left)

renderDebug() =>
    table.clear(dbg, 0, 0, 2, 39)
    int r = 0
    table.cell(dbg, 0, r, "ACE DEBUG", cText, text_size = size.tiny, text_halign = text.align_left)
    table.cell(dbg, 1, r, ACE_VERSION, cAccent, text_size = size.tiny, text_halign = text.align_left)
    table.cell(dbg, 2, r, ACE_PHASE, cMuted, text_size = size.tiny, text_halign = text.align_left)
    r += 1

    if dbgRuntime
        dbgRow(r, "bar_index", str.tostring(bar_index), cText)
        r += 1
        dbgRow(r, "mintick", str.tostring(syminfo.mintick), cText)
        r += 1
        dbgRow(r, "tf seconds", str.tostring(timeframe.in_seconds()), cText)
        r += 1
        dbgRow(r, "volume valid", volumeValid ? "true" : "false", volumeValid ? cBull : cWarn)
        r += 1
        dbgRow(r, "bar confirmed", barConfirmed ? "true" : "false", barConfirmed ? cBull : cWarn)
        r += 1
        dbgRow(r, "profile source", resolvedSource, cText)
        r += 1
        dbgRow(r, "delta source", resolvedDeltaSource, cText)
        r += 1
        dbgRow(r, "delta value", fmt(deltaProxy, format.volume), cText)
        r += 1
        dbgRow(r, "rvol", fmt(rvol, "0.00"), cText)
        r += 1
        dbgRow(r, "perf mode", str.tostring(perfMode), cText)
        r += 1
        dbgRow(r, "bins / profiles", str.tostring(resolvedBins) + " / " + str.tostring(resolvedProfiles), cText)
        r += 1
        dbgRow(r, "max zones", str.tostring(resolvedMaxZones), cText)
        r += 1
        dbgRow(r, "developing", devEnabled ? "every " + str.tostring(resolvedDevRecalc) : "off", cText)
        r += 1
        dbgRow(r, "components", str.tostring(score.activeCount) + " active / " + str.tostring(score.enabledCount) + " enabled", cText)
        r += 1
        dbgRow(r, "profile src", useTpoSrc ? "TPO" : "VOLUME", useTpoSrc ? cWarn : cText)
        r += 1
        dbgRow(r, "prof bins/cap", str.tostring(curProf.bins) + " / " + str.tostring(binCapHard), curProf.clamped ? cWarn : cText)
        r += 1
        dbgRow(r, "prof step", str.tostring(curProf.step, format.mintick), cText)
        r += 1
        dbgRow(r, "prof range", fmt(curProf.lo, format.mintick) + " .. " + fmt(curProf.hi, format.mintick), cText)
        r += 1
        dbgRow(r, "prof total", fmt(useTpoSrc ? curProf.tpoTotal : curProf.total, format.volume), cText)
        r += 1
        dbgRow(r, "prof bars", str.tostring(bar_index - curProf.startBar + 1), cText)
        r += 1
        dbgRow(r, "value pos", fmt(valuePos, "0.000"), cText)
        r += 1
        dbgRow(r, "vwap primary", primaryName + " " + fmt(vwapVal, format.mintick), vwapValid ? cText : cWarn)
        r += 1
        dbgRow(r, "vwap sigma", fmt(vwapSd, format.mintick), cText)
        r += 1
        dbgRow(r, "vwap z", fmt(vwapZ, "0.000"), cText)
        r += 1
        dbgRow(r, "session vwap", fmt(accSession.vwap, format.mintick), cText)
        r += 1
        dbgRow(r, "ta.vwap ref", fmt(refVwap, format.mintick), cText)
        r += 1
        dbgRow(r, "diff (ticks)", fmt(vwapDiffTicks, "0.0000"),
             na(vwapDiffTicks) ? cMuted : vwapDiffTicks < 0.5 ? cBull : cWarn)
        r += 1
        dbgRow(r, "anchored #1/#2", anc1Status + " / " + anc2Status, cText)
        r += 1

    if dbgEngines
        dbgEngineRow(r, engProfile)
        r += 1
        dbgEngineRow(r, engStruct)
        r += 1
        dbgEngineRow(r, engVwap)
        r += 1
        dbgEngineRow(r, engAmt)
        r += 1
        dbgEngineRow(r, engLiq)
        r += 1
        dbgEngineRow(r, engImb)
        r += 1
        dbgEngineRow(r, engVol)
        r += 1

// ============================================================================
//  14b. PROFILE RENDER                                                    [P1]
//  Objects are pooled and updated in place - never recreated per bar - so the
//  script stays inside the 500-object limits and does not churn the drawing
//  engine. Rendering happens only on the last bar.
// ============================================================================

var array<box>  curBoxes = array.new<box>()
var array<box>  prvBoxes = array.new<box>()
var array<line> lvlLines = array.new<line>()

//@function Resizes a box pool to exactly `need` elements.
syncBoxes(array<box> pool, int need) =>
    while pool.size() > need
        box.delete(pool.pop())
    while pool.size() < need
        pool.push(box.new(bar_index, close, bar_index, close, border_width = 0,
             xloc = xloc.bar_index))

//@function Resizes a line pool to exactly `need` elements.
syncLines(array<line> pool, int need) =>
    while pool.size() > need
        line.delete(pool.pop())
    while pool.size() < need
        pool.push(line.new(bar_index, close, bar_index, close, xloc = xloc.bar_index))

//@function Draws one horizontal level from the pool, or hides it when `show`
//          is false / the value is na. Hiding must be explicit: leaving a line
//          at its last position would show a stale level.
putLevel(array<line> pool, int slot, bool show, int x1, int x2, float y, color col, int wid, string sty, bool ext) =>
    if slot < pool.size()
        line l = array.get(pool, slot)
        if show and not na(y)
            line.set_xy1(l, x1, y)
            line.set_xy2(l, x2, y)
            line.set_color(l, col)
            line.set_width(l, wid)
            line.set_style(l, sty)
            line.set_extend(l, ext ? extend.right : extend.none)
        else
            line.set_xy1(l, bar_index, close)
            line.set_xy2(l, bar_index, close)
            line.set_color(l, color.new(col, 100))
            line.set_extend(l, extend.none)

//@function Renders a profile histogram into a pooled set of boxes.
renderHisto(Profile p, array<box> pool, bool useTpo, int x1, int widthBars, int transp) =>
    array<float> src = useTpo ? p.tpo : p.vol
    int n = p.bins
    float mx = n > 0 ? array.max(src) : 0.0
    if n > 0 and mx > 0 and widthBars > 0
        array<int> tags = showNodes ? profNodes(p, useTpo, nodeWin, hvnThr, lvnThr) : array.new<int>(n, 0)
        syncBoxes(pool, n)
        for i = 0 to n - 1
            float v = array.get(src, i)
            float mid = pBinMid(p, i)
            bool inVa = not na(p.vah) and not na(p.val) and mid >= p.val and mid <= p.vah
            int tag = array.get(tags, i)
            color base = tag == 1 ? cAccent : tag == -1 ? cWarn : (inVa ? cBull : cMuted)
            int alpha = tag == -1 ? math.min(95, transp + 25) : (inVa ? transp : math.min(95, transp + 15))
            int w = int(math.round(widthBars * v / mx))
            box b = array.get(pool, i)
            box.set_lefttop(b, x1, pBinHigh(p, i))
            box.set_rightbottom(b, x1 + math.max(w, 0), pBinLow(p, i))
            box.set_bgcolor(b, color.new(base, alpha))
            box.set_border_color(b, color.new(base, 100))
    else
        syncBoxes(pool, 0)

renderProfiles() =>
    if not showFacts
        syncBoxes(curBoxes, 0)
        syncBoxes(prvBoxes, 0)
        syncLines(lvlLines, 0)
    else
        // Current period.
        if showHisto and curProf.bins > 0 and curProf.bins <= 300
            int span = math.max(1, bar_index - curProf.startBar)
            int w = math.max(2, int(math.round(span * histoWidthPct / 100.0)))
            renderHisto(curProf, curBoxes, useTpoSrc, curProf.startBar, w, 70)
        else
            syncBoxes(curBoxes, 0)

        // Previous period.
        bool prevOn = showHisto and showPrevProfile and resolvedProfiles > 1 and prvProf.bins > 0 and prvProf.bins <= 300
        if prevOn
            int span = math.max(1, prvProf.endBar - prvProf.startBar)
            int w = math.max(2, int(math.round(span * histoWidthPct / 100.0)))
            renderHisto(prvProf, prvBoxes, useTpoSrc, prvProf.startBar, w, 85)
        else
            syncBoxes(prvBoxes, 0)

        // Levels: current POC/VAH/VAL, then previous POC/VAH/VAL.
        syncLines(lvlLines, 6)
        int x2 = bar_index
        bool prevLv = showPrevProfile and resolvedProfiles > 1 and prvProf.ready
        putLevel(lvlLines, 0, showPoc, curProf.startBar, x2, curProf.poc, cAccent, 2, line.style_solid, extendLevels)
        putLevel(lvlLines, 1, showVa,  curProf.startBar, x2, curProf.vah, cBull, 1, line.style_dashed, extendLevels)
        putLevel(lvlLines, 2, showVa,  curProf.startBar, x2, curProf.val, cBear, 1, line.style_dashed, extendLevels)
        putLevel(lvlLines, 3, prevLv, prvProf.startBar, prvProf.endBar, prvProf.poc, cMuted, 1, line.style_dotted, false)
        putLevel(lvlLines, 4, prevLv, prvProf.startBar, prvProf.endBar, prvProf.vah, cMuted, 1, line.style_dotted, false)
        putLevel(lvlLines, 5, prevLv, prvProf.startBar, prvProf.endBar, prvProf.val, cMuted, 1, line.style_dotted, false)

// ============================================================================
//  15. RENDER
// ============================================================================

// Guard: thresholds must be strictly increasing, otherwise the classification
// silently collapses into a single band.
assert(thrNeutral < thrWeak and thrWeak < thrStrong,
     "context thresholds must satisfy neutral < weak < strong")

bool inDrawWindow = bar_index > last_bar_index - maxDrawBars

if barstate.islast
    renderProfiles()

if barstate.islast
    if showDash
        renderDashboard()
    else
        table.clear(dash, 0, 0, 4, 25)
    if dbgOn
        renderDebug()
    else
        table.clear(dbg, 0, 0, 2, 39)

// Keeps the pane scale stable and gives the script a plot to hang alerts on
// in later phases. Invisible by design.
// Developing POC / VA. Plotted as breakable lines so they reset cleanly at the
// start of each profile period instead of bridging across it.
plot(devEnabled and showDevPoc ? devPoc : na, "Developing POC", cAccent, 1, plot.style_linebr)
plot(devEnabled and showDevPoc ? devVah : na, "Developing VAH", color.new(cBull, 40), 1, plot.style_linebr)
plot(devEnabled and showDevPoc ? devVal : na, "Developing VAL", color.new(cBear, 40), 1, plot.style_linebr)

// ---- VWAP plots ------------------------------------------------------------
// Plotted live: a VWAP moving inside the forming bar is normal behaviour, not
// repainting. Closed-bar values never change.
bool vwOn = showFacts and volumeValid

plot(vwOn and useSessionVwap and accSession.valid ? accSession.vwap : na, "Session VWAP", cAccent, 2)
plot(vwOn and useDailyVwap   and accDaily.valid   ? accDaily.vwap   : na, "Daily VWAP",   #42a5f5, 1)
plot(vwOn and useWeeklyVwap  and accWeekly.valid  ? accWeekly.vwap  : na, "Weekly VWAP",  #ab47bc, 1)
plot(vwOn and useMonthlyVwap and accMonthly.valid ? accMonthly.vwap : na, "Monthly VWAP", #8d6e63, 1)
plot(vwOn and useAnchored1 and accAnc1.valid ? accAnc1.vwap : na, "Anchored VWAP 1", #26c6da, 1)
plot(vwOn and useAnchored2 and accAnc2.valid ? accAnc2.vwap : na, "Anchored VWAP 2", #ffa726, 1)

bool bandsOn = vwOn and showVwapBands
pU1 = plot(bandsOn ? bandU1 : na, "VWAP +1σ", color.new(cBull, 45), 1)
pL1 = plot(bandsOn ? bandL1 : na, "VWAP -1σ", color.new(cBear, 45), 1)
plot(bandsOn ? bandU2 : na, "VWAP +2σ", color.new(cBull, 65), 1)
plot(bandsOn ? bandL2 : na, "VWAP -2σ", color.new(cBear, 65), 1)
plot(bandsOn ? bandU3 : na, "VWAP +3σ", color.new(cBull, 80), 1)
plot(bandsOn ? bandL3 : na, "VWAP -3σ", color.new(cBear, 80), 1)
fill(pU1, pL1, showVwapFill and bandsOn ? color.new(cAccent, 93) : na, title = "VWAP band fill")

plot(close, "ACE anchor", display = display.none, editable = false)
